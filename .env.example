# Supabase — get values from Project Settings → API in your Supabase dashboard
# Use the base project URL (not /rest/v1) and the publishable (anon) key only.
# Set the same variables in the Vercel dashboard for Production / Preview.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local scripts only (never expose in the browser or Vercel NEXT_PUBLIC_* vars)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
